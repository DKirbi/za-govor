{
  "name": "za-govor",
  "version": "0.1.0",
  "private": true,
  "description": "Za govor — a Slovene word-puzzle RPG with Slavic mythology. Browser prototype of the mini-games, also wrapped as an Android test app (Capacitor).",
  "scripts": {
    "build": "python3 build.py",
    "test": "node tests/run-all.js",
    "test:desktop": "node tests/desktop.test.js",
    "test:phone": "node tests/phone.test.js",
    "test:crosswords": "node tests/crossword-generator.test.js",
    "test:keyword": "node tests/keyword.test.js",
    "test:levels": "node tests/levels.test.js",
    "test:journey": "node tests/journey.test.js",
    "test:lexicon": "node tests/lexicon.test.js",
    "test:menu": "node tests/menu.test.js",
    "screenshots": "node tools/readme-shots.js",
    "android:sync": "python3 build.py && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "puppeteer-core": "^23.11.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  }
}
